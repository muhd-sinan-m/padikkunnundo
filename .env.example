# ── Application Secrets ───────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-a-shared-jwt-secret
SSO_SECRET=change-this-to-a-shared-sso-secret

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local development:
DATABASE_URL=sqlite:///padikkunnundo.db
# PostgreSQL for production (AWS RDS / Supabase):
# DATABASE_URL=postgresql://username:password@host:5432/padikkunnundo

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── College Configuration ─────────────────────────────────────────────────────
COLLEGE_DOMAIN=mariancollege.org

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URL=memory://

# ── Email / Password Reset (Resend API) ───────────────────────────────────────
RESEND_API_KEY=re_your-resend-api-key
MAIL_FROM=noreply@padikkunnundo.app
RESET_TOKEN_EXPIRY_SECONDS=3600

# ── Sister Platform URLs ──────────────────────────────────────────────────────
PYQPORTAL_URL=https://pyqportal.app
MCQ_QUIZ_URL=https://mcq-portal-ldf6.onrender.com/
LAB_PRACTICE_URL=https://lab.pyqportal.app
PASSAVAM_URL=https://passavam.onrender.com
MARK_ANALYSER_URL=https://markkundo.app
DOUBTUNDO_URL=https://doubtundo.onrender.com/
